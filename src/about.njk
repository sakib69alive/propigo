---
permalink: about/index.html
canonicalPath: "about/"
pageTitle: "About Propigo — what we do"
pageDesc: "What Propigo is, what we do, who we work with and how to collaborate."
---
{% extends "base.njk" %}
{% block content %}
<section class="hero sub-hero rise" aria-labelledby="h1">
  <span class="label">{{ site.company.kicker }}</span>
  <h1 id="h1">{{ site.about_page.title }}</h1>
  <p class="tagline">{{ site.about_page.intro }}</p>
</section>

{% for sec in site.about_page.sections %}{% if sec.id != "collaborate" %}
<section class="panel-card rise" aria-labelledby="s{{ loop.index }}">
  <span class="label">0{{ loop.index }}</span>
  <h2 id="s{{ loop.index }}">{{ sec.title }}</h2>
  {% for p in sec.text %}<p{% if loop.first and sec.text.length > 1 %} class="lead"{% endif %}>{{ p }}</p>{% endfor %}
  {% if sec.points %}<ul class="points">{% for p in sec.points %}<li>{{ p }}</li>{% endfor %}</ul>{% endif %}
</section>
{% endif %}{% endfor %}

{% if site.how.steps.length %}
<section class="panel-card" aria-labelledby="how-h">
  <span class="label">Process</span>
  <h2 id="how-h">{{ site.how.title }}</h2>
  {% include "steps.njk" %}
</section>
{% endif %}

{% if site.categories.length %}
<section class="panel-card" aria-labelledby="promote-h">
  <span class="label">Focus</span>
  <h2 id="promote-h">What we promote</h2>
  {% include "categories.njk" %}
</section>
{% endif %}

{% for sec in site.about_page.sections %}{% if sec.id == "collaborate" %}
<section class="panel-card" id="collaborate" aria-labelledby="collab-h">
  <span class="label">Collaborate</span>
  <h2 id="collab-h">{{ sec.title }}</h2>
  {% for p in sec.text %}<p>{{ p }}</p>{% endfor %}
  {% include "contact.njk" %}
  <a class="btn gold block" style="margin-top:var(--s4)" href="{{ '/collaborate/' | url }}">{{ icons.handshake | safe }}Collaborate with {{ site.company.name }}</a>
  <a class="btn alt block" style="margin-top:var(--s3)" href="{{ '/founder/' | url }}">{{ icons.user | safe }}Meet the founder</a>
</section>
{% endif %}{% endfor %}

<p class="backrow"><a class="more" href="{{ '/' | url }}">{{ icons['arrow-left'] | safe }}Back to {{ site.company.name }}</a></p>
{% endblock %}
