<section class="card hero rise" aria-labelledby="who">
  <div class="portrait" aria-hidden="{{ 'false' if site.founder.photo else 'true' }}">
    {% if site.founder.photo %}
      <img src="{{ '/assets/founder.webp' | url }}" width="126" height="142" alt="Portrait of {{ site.founder.name }}" decoding="async" fetchpriority="high">
    {% else %}
      <i>{{ site.founder.initials }}</i>
    {% endif %}
  </div>
  <h1 id="who">{{ site.founder.name }}</h1>
  <p class="role">{{ site.founder.title }}, {{ site.company.name }}</p>
  <p class="tagline">{{ site.company.tagline }}</p>
  <div class="actions">
    <a class="btn block" href="{{ '/propigo.vcf' | url }}" download="propigo-contact.vcf">{{ icons['user-plus'] | safe }}Save contact</a>
    {% if site.contact.whatsapp or site.contact.phone %}
    <div class="pair">
      {% if site.contact.whatsapp %}
      <a class="btn alt" href="https://wa.me/{{ site.contact.whatsapp_digits }}?text={{ site.contact.whatsapp_message | encode }}" target="_blank" rel="noopener noreferrer">{{ icons.whatsapp | safe }}WhatsApp</a>
      {% endif %}
      {% if site.contact.phone %}
      <a class="btn alt" href="tel:{{ site.contact.phone }}">{{ icons.phone | safe }}Call</a>
      {% endif %}
    </div>
    {% endif %}
  </div>
</section>
