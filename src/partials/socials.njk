{# Expects `socialList` (array of {platform,url}) and `socialWho` (name for labels). Icons without a link stay visible but inert. #}
<ul class="socials">
  {% for s in socialList %}
  <li>
    {% if s.url %}
    <a class="soc" href="{{ s.url }}" target="_blank" rel="noopener noreferrer" aria-label="{{ socialWho }} on {{ brandNames[s.platform] }}">{{ icons[s.platform] | safe }}</a>
    {% else %}
    <span class="soc off" role="img" aria-label="{{ brandNames[s.platform] }} (link coming soon)">{{ icons[s.platform] | safe }}</span>
    {% endif %}
    <span class="soc-name">{{ brandNames[s.platform] }}</span>
  </li>
  {% endfor %}
</ul>
