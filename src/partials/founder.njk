<section class="section" aria-labelledby="note-h">
  <span class="label">Founder's note</span>
  <h2 id="note-h">A word from {{ site.founder.name }}</h2>
  {% if site.founder.intro %}<p>{{ site.founder.intro }}</p>{% endif %}
  {% if site.founder.statement %}<p class="quote">{{ site.founder.statement }}</p>{% endif %}
</section>
