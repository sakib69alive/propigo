---
permalink: index.html
canonicalPath: ""
---
{% extends "base.njk" %}
{% block content %}
<section class="hero rise" aria-labelledby="h1">
  <div class="art">{{ heroArt | safe }}</div>
  <span class="label">{{ site.company.kicker }}</span>
  <h1 id="h1">{{ site.company.name }}</h1>
  <p class="tagline">{{ site.company.tagline }}</p>
  <a class="btn gold" href="{{ '/about/' | url }}">Read more about {{ site.company.name }}{{ icons['arrow-right'] | safe }}</a>
</section>

<section class="panel-card rise d1" aria-labelledby="about-h">
  <span class="label">What we do</span>
  <h2 id="about-h">What {{ site.company.name }} does</h2>
  {% for line in site.company.about %}<p{% if loop.first %} class="lead"{% endif %}>{{ line }}</p>{% endfor %}
  {% include "steps.njk" %}
  {% if site.categories.length %}
  <span class="label sub-label">What we promote</span>
  {% include "categories.njk" %}
  {% endif %}
  <a class="more" href="{{ '/about/' | url }}">Read the full story{{ icons['arrow-right'] | safe }}</a>
</section>

<section class="panel-card" aria-labelledby="contact-h" id="contact">
  <span class="label">Contact</span>
  <h2 id="contact-h">Get in touch with {{ site.company.name }}</h2>
  {% include "contact.njk" %}
  <h3 class="sub">Follow {{ site.company.name }}</h3>
  {% set socialList = site.socials.company %}{% set socialWho = site.company.name %}
  {% include "socials.njk" %}
  <a class="btn alt block" href="{{ '/propigo.vcf' | url }}" download="propigo-contact.vcf">{{ icons['user-plus'] | safe }}Save contact</a>
</section>

<section class="cta" aria-labelledby="cta-h">
  <span class="label">Collaborate</span>
  <h2 id="cta-h">{{ site.cta.title }}</h2>
  <p>{{ site.cta.text }}</p>
  <div class="actions">
    {% if site.contact.whatsapp %}
    <a class="btn gold block" href="https://wa.me/{{ site.contact.whatsapp_digits }}?text={{ site.contact.whatsapp_message | encode }}" target="_blank" rel="noopener noreferrer">{{ icons.handshake | safe }}Collaborate with {{ site.company.name }}</a>
    {% elif site.contact.email %}
    <a class="btn gold block" href="mailto:{{ site.contact.email }}">{{ icons.handshake | safe }}Collaborate with {{ site.company.name }}</a>
    {% else %}
    <a class="btn gold block" href="{{ '/about/#collaborate' | url }}">{{ icons.handshake | safe }}Collaborate with {{ site.company.name }}</a>
    {% endif %}
    <a class="btn alt block" href="{{ '/founder/' | url }}">{{ icons.user | safe }}Meet the founder</a>
  </div>
</section>
{% endblock %}
